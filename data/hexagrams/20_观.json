  "卦辞": {
    "原文": "盥而不荐，有孚颙若。",
    "白话": "祭祀前洗手自洁，尚未进献祭品，心中已充满诚敬肃穆。",
    "彖传": "大观在上，顺而巽，中正以观天下。观，盥而不荐，有孚颙若，下观而化也。观天之神道，而四时不忒；圣人以神道设教，而天下服矣。",
    "大象传": "风行地上，观；先王以省方，观民设教。",
    "关键词": [
      "观察",
      "省方设教",
      "神道设教",
      "下观而化"
    ],
    "吉凶标签": "重在诚敬感化"
  },
